# Environment
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Vendored upstream checkout (has its own .git; installed as an editable dep)
dev/

# Generated artifacts. Everything here is reproducible from the code plus a
# seed, and the images and databases are large.
results/
runs*/
*.log

# Local working state: each contributor accumulates their own.
.claude/tasks/

# Papers. Publisher PDFs, tens of MB, and git keeps them forever once they are
# in. Cite them in prose instead; they are inputs to read, not artifacts to
# version.
references/
